<?xml version="1.0"?>
<ruleset name="BYOT Accounting">
	<description>Coding standard for the BYOT Accounting plugin.</description>

	<file>.</file>
	<exclude-pattern>/assets/js/vendor/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>

	<arg value="sp"/>
	<arg name="basepath" value="./"/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>

	<rule ref="WordPress">
		<!--
		The plugin's spl_autoload_register() callback derives each file name by
		stripping the "BYOT_Acc_" prefix from the class name (see
		byot-accounting.php), so file names intentionally do not repeat the
		full class name. Renaming would require rewriting the autoloader for
		no functional benefit.
		-->
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_woocommerce"/>
			</property>
		</properties>
	</rule>

	<config name="minimum_supported_wp_version" value="5.8"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="byot-accounting"/>
			</property>
		</properties>
	</rule>
</ruleset>
